# ----------------------------------------------------
# BENGALURU DIGITAL TWIN - PMO DEPLOYMENT ENVIRONMENT
# ----------------------------------------------------

# 1. Macro-Telemetry (Spatial APIs)
TOMTOM_API_KEY=your_tom_tom_prod_key_here
TOMTOM_POLL_RATE_SECONDS=60

# 2. Environmental Variables
OPENWEATHER_API_KEY=your_openweather_api_key_here
BENGALURU_LAT=12.9716
BENGALURU_LON=77.5946

# 3. Vision Stream Hub (RTSP Edge Backhaul URLs)
# Requires high-bandwidth connectivity mapped directly to the BTP hardware.
RTSP_SILK_BOARD=rtsp://admin:secure_pass1@192.168.1.101/stream1
RTSP_HEBBAL=rtsp://admin:secure_pass1@192.168.1.102/stream1
RTSP_TIN_FACTORY=rtsp://admin:secure_pass1@192.168.1.103/stream1
RTSP_MG_ROAD=rtsp://admin:secure_pass1@192.168.1.104/stream1
